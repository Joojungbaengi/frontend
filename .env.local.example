# 이 파일을 복사해서 .env.local 로 저장하고 실제 값을 채우세요.
# .env.local 은 .gitignore 에 의해 깃허브에 올라가지 않습니다. (절대 직접 커밋 금지!)

# AWS Bedrock 자격 증명 (IAM 사용자에서 발급)
AWS_ACCESS_KEY_ID=발급받은_액세스_키
AWS_SECRET_ACCESS_KEY=발급받은_시크릿_키
AWS_REGION=ap-northeast-2

# Bedrock에서 사용할 Claude 모델 (Bedrock 콘솔 > Model access 에서 활성화 필요)
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# 참고: AWS 키가 없으면 /api/recommend 는 자동으로 규칙 기반 추천(fallback)으로 동작합니다.
# 프론트 개발할 때는 키 없이도 진행 가능해요.
